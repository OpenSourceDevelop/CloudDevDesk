# =============================================================================
#  OpenCode stack (CloudLab) – environment variables
#  Create a copy as .env (in Arcane: the project's .env editor). Never commit it.
# =============================================================================

# --- Access (required) -------------------------------------------------------
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=          # openssl rand -base64 32
CODE_SERVER_PASSWORD=              # separate password for code-server

# --- User / resources --------------------------------------------------------
PUID=1000                          # UID of "debian" on CloudLab
PGID=1000
MEM_LIMIT=8g
CPU_LIMIT=8

# --- Images ------------------------------------------------------------------
OPENCODE_IMAGE_TAG=latest          # base ghcr.io/joostme/opencode-docker (e.g. v2.3.8)
RUSTDESK_VERSION=1.4.9             # "latest" = newest version on every build
# PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp:<version>

# --- LLM providers (only the ones you need) ----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- MCP / GitHub ------------------------------------------------------------
CONTEXT7_API_KEY=                  # optional, higher rate limit
GH_TOKEN=                          # fine-grained token, only the repos you need

# --- Desktop sidecar (RustDesk) ----------------------------------------------
RUSTDESK_SERVER=rustdesk.example.nip.io   # public name of the self-hosted hbbs
RUSTDESK_KEY=                      # contents of the hbbs id_ed25519.pub
RUSTDESK_PASSWORD=                 # permanent access password, no '
DESKTOP_RESOLUTION=1920x1080x24
